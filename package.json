{
  "name": "dhaka-jam-short",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "sfx": "tsx scripts/generate-sfx-jam.ts",
    "export-text": "tsx scripts/export-narration.ts",
    "voice": "bash scripts/generate-voice.sh",
    "srt": "tsx scripts/make-srt.ts",
    "audio": "npm run sfx && npm run voice",
    "still": "remotion still src/index.ts DhakaJam out/preview.png --frame=150",
    "render": "bash scripts/render.sh",
    "typecheck": "tsc --noEmit",
    "eleven": "tsx scripts/elevenlabs-dialogue.ts",
    "speaker-srt": "tsx scripts/export-speaker-srt.ts"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "@remotion/media-utils": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.3",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
